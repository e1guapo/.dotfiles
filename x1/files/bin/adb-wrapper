#!/bin/bash
echo "DEBUG adb-wrapper called with: $@" >&2
# If first arg is a serial (contains a colon), use it with -s
if [[ "$1" == *":"* ]]; then
    serial="$1"
    shift
    echo "DEBUG using serial: $serial" >&2
    # start-server/kill-server are local operations; -s would target the remote host
    if [[ "$1" == "start-server" || "$1" == "kill-server" ]]; then
        command adb "$@"
    # scrcpy already passed -s <serial>; pass args through to avoid duplicate
    elif [[ "$1" == "-s" ]]; then
        command adb "$@"
    else
        command adb -s "$serial" "$@"
    fi
else
    echo "DEBUG no serial detected" >&2
    command adb "$@"
fi
